FIELDNOTE_ORIGIN=http://localhost:5173
# Its exact hostname is also accepted by the Host-header boundary, alongside
# localhost, 127.0.0.1 and ::1. Wildcards and subdomains are not implied.
# Optional, for a new WSL deployment: a private persistent native Linux directory.
# Do not set an empty value. Changing this does not migrate existing interviews.
# FIELDNOTE_DATA=/home/YOUR_USER/.local/share/fieldnote
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: existing Codex CLI executable on the API host; run codex login there.
# CODEX_CLI_PATH=C:/path/to/codex.exe
# Codex uses subscription allowance, not the provider API keys above.
# Dedicated Ubuntu PC only. Never execute candidate code on the application host.
RUNNER_URL=
RUNNER_BEARER_TOKEN=


# Generate a long random value and provide the same value to the application backend.
RUNNER_BEARER_TOKEN=replace-with-at-least-32-random-bytes
RUNNER_DATABASE=/var/lib/fieldnote-runner/jobs.sqlite3
RUNNER_CONTENT_ROOT=/srv/fieldnote/content
RUNNER_PYTHON_IMAGE=fieldnote-runner-python:3.11-v1
RUNNER_CPP_COMPILE_IMAGE=fieldnote-runner-cpp-compiler:20-v1
RUNNER_CPP_RUNTIME_IMAGE=fieldnote-runner-cpp-runtime:20-v1
